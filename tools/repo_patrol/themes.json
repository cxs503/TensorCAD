  "risk_rules": {
    "large_churn_lines": 1000,
    "bus_factor_min_commits": 10,
    "gate_filtered_pattern": "被门禁滤除",
    "gate_filtered_count_pattern": "（(\\d+) 个文件被门禁滤除）",
    "merge_subject_pattern": "Merge #(\\d+) \\(m(\\d+)\\) via ([a-z-]+)",
    "mission_pattern": "m(\\d+)",
